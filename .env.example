# For host-based local development, use localhost. Docker Compose overrides
# this with the internal hostname `db` for its containers.
DATABASE_URL=postgresql+psycopg://tickets:tickets@localhost:5432/tickets

# Replace this value with a randomly generated secret before using the API.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-this-with-a-long-random-secret

ACCESS_TOKEN_MINUTES=60
HOLD_TTL_SECONDS=600
AUTO_CREATE_SCHEMA=false

# Leave blank to disable Redis locally. Docker Compose sets the service URL.
REDIS_URL=
RATE_LIMIT_REQUESTS_PER_MINUTE=120
EVENT_CACHE_TTL_SECONDS=30
